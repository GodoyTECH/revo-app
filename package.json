{
  "name": "organizacao-revolucionarios-app",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "predev": "npm run build",
    "dev": "node scripts/server.mjs dist",
    "build": "node scripts/generate-icons.mjs && node scripts/build.mjs",
    "preview": "node scripts/server.mjs dist",
    "pretest": "node scripts/generate-icons.mjs",
    "test": "node --test tests/*.test.js",
    "icons": "node scripts/generate-icons.mjs",
    "migrate": "node scripts/migrate.mjs",
    "lint": "node --check src/main.js && node --check netlify/functions/api.mjs",
    "typecheck": "node --check src/main.js && node --check netlify/functions/api.mjs",
    "test:browser": "npm run build && playwright test"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@tesseract.js-data/por": "^1.0.0",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.64.1",
    "@sparticuz/chromium": "^153.0.0"
  }
}
