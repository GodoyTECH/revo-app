{
  "name": "organizacao-revolucionarios-app",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "predev": "node scripts/generate-icons.mjs",
    "dev": "node scripts/server.mjs",
    "build": "node scripts/generate-icons.mjs && node scripts/build.mjs",
    "preview": "node scripts/server.mjs dist",
    "pretest": "node scripts/generate-icons.mjs",
    "test": "node --test tests/*.test.js",
    "icons": "node scripts/generate-icons.mjs",
    "migrate": "node scripts/migrate.mjs",
    "lint": "node --check src/main.js && node --check netlify/functions/api.mjs",
    "typecheck": "node --check src/main.js && node --check netlify/functions/api.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2"
  }
}
